# Auth0 SDK v4 — requeridas
AUTH0_SECRET=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# URL pública de esta app (sin barra final). Antes: AUTH0_BASE_URL
APP_BASE_URL=http://localhost:8090
# Dominio del tenant, sin https (ej. dev-xxx.us.auth0.com). Antes: AUTH0_ISSUER_BASE_URL
AUTH0_DOMAIN=

# API audience (opcional si ya va en login; se usa para tokens al backend Nest)
AUTH0_AUDIENCE=
NEXT_PUBLIC_AUDIENCE=https://be.dott-pc.com.ar

# Backend Nest: usada por las rutas API de Next (servidor) para llamar al backend.
# Local: si Nest corre en 8090, usar http://localhost:8090
NEXT_PUBLIC_APP_API_SERVER_URL=http://localhost:8090
NEXT_PUBLIC_PYTHON_API_SERVER_URL=http://localhost:5000
NEXT_PUBLIC_LOCAL_DEV_AUTH_BYPASS=true
LOCAL_DEV_AUTH_BYPASS=true
# JWT para llamadas al backend cuando LOCAL_DEV_AUTH_BYPASS=true
LOCAL_DEV_BEARER_TOKEN=

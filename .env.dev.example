# =========================
# Dott-PC local development
# =========================

# MySQL
MYSQL_ROOT_PASSWORD=dott_root_dev
MYSQL_DATABASE=dottdb
MYSQL_USER=do0tt
MYSQL_PASSWORD=do0tt_dev_password

# Backend runtime
ISSUER_BASE_URL=https://dev-3hmy3galmqfty1xt.us.auth0.com
AUDIENCE=https://be.dott-pc.com.ar
CLIENT_ORIGIN_URL=http://localhost:8090

# HTTPS in Nest backend
ENABLE_HTTPS=false
HTTPS_KEY_PATH=./secrets/privkey.pem
HTTPS_CERT_PATH=./secrets/fullchain.pem

# JWT
JWT_AT_SECRET=dev-at-secret-change-me
JWT_RT_SECRET=dev-rt-secret-change-me

# Backend DB settings
DB_HOST=mysql
DB_PORT=3306
DB_USER=do0tt
DB_PASSWORD=do0tt_dev_password
DB_NAME=dottdb
DB_SYNC=true
LOCAL_DEV_AUTH_BYPASS=true

# RabbitMQ
RABBITMQ_QUEUE=RABBIT_MR_DOTT_QUEUE
RABBITMQ_PYTHON_QUEUE=PYTHON_QUEUE
RABBITMQ_RETRY_DELAY=5

# ===========================================
# Dott-PC Backend - Environment variables
# ===========================================
# Copy to .env and set values. Never commit .env with real secrets.
# For production, use a vault or secret manager instead of .env.

# ---------- Auth (Auth0) ----------
ISSUER_BASE_URL=https://your-tenant.auth0.com/
AUDIENCE=https://api.dott.example
CLIENT_ORIGIN_URL=http://localhost:3000

# ---------- Optional: local auth bypass (dev only) ----------
# NODE_ENV=development
# LOCAL_DEV_AUTH_BYPASS=false

# ---------- JWT (only if using local JWT in addition to Auth0) ----------
# JWT_AT_SECRET=
# JWT_RT_SECRET=

# ---------- Database ----------
DB_HOST=mysql
DB_PORT=3306
DB_USER=do0tt
DB_PASSWORD=
DB_NAME=dottdb
DB_SYNC=false

# ---------- RabbitMQ ----------
RABBIT_MQ_URI=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=dott_queue
RABBITMQ_PYTHON_QUEUE=python_queue

# ---------- HTTPS (optional) ----------
# ENABLE_HTTPS=false
# HTTPS_KEY_PATH=./secrets/privkey.pem
# HTTPS_CERT_PATH=./secrets/fullchain.pem

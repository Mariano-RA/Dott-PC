# =============================================================================
# Dott-PC - Variables de entorno (desarrollo y producción)
# =============================================================================
# Copiá a .env y reemplazá los valores. Nunca subas .env con secretos reales.
# Desarrollo: valores locales / pruebas. Producción: URLs reales y secretos fuertes.
# Con un solo docker-compose.yml, solo cambiás este archivo (o usás .env.prod).
# =============================================================================

# ---------- Entorno ----------
NODE_ENV=production
# Desarrollo: NODE_ENV=development

# ---------- MySQL (mismo usuario para backend y compose) ----------
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=dottdb
MYSQL_USER=do0tt
MYSQL_PASSWORD=change_this_db_password

# ---------- Backend - Auth (Auth0) ----------
ISSUER_BASE_URL=https://your-tenant.auth0.com/
AUDIENCE=https://api.dott.example
CLIENT_ORIGIN_URL=http://localhost:8090
# Producción: CLIENT_ORIGIN_URL=https://tu-dominio.com

# ---------- Backend - JWT (secretos locales) ----------
JWT_AT_SECRET=change_this_at_secret
JWT_RT_SECRET=change_this_rt_secret

# ---------- Backend - Base de datos (host = nombre del servicio en compose) ----------
DB_HOST=mysql
DB_PORT=3306
DB_USER=do0tt
DB_PASSWORD=change_this_db_password
DB_NAME=dottdb
DB_SYNC=false

# ---------- Backend - HTTPS (opcional) ----------
ENABLE_HTTPS=false
HTTPS_KEY_PATH=./secrets/privkey.pem
HTTPS_CERT_PATH=./secrets/fullchain.pem

# ---------- RabbitMQ (URLs completas; host = nombre del servicio en compose) ----------
RABBIT_MQ_URI=amqp://guest:guest@dottpc-rabbit:5672/
RABBITMQ_URL=amqp://guest:guest@dottpc-rabbit:5672/
RABBITMQ_QUEUE=RABBIT_MR_DOTT_QUEUE
RABBITMQ_PYTHON_QUEUE=PYTHON_QUEUE
RABBITMQ_FETCH_PRICES_QUEUE=fetch_prices
RABBITMQ_RETRY_DELAY=5

# ---------- Puertos expuestos (opcional) ----------
# RABBIT_PORT_AMQP=5672
# RABBIT_PORT_MGMT=15672
# MYSQL_PORT=3306
# BACKEND_PORT=3000
# PYTHON_API_PORT=5000

# ---------- Backend - Categorías (diccionarios nuevos/diccionarios.json) ----------
# En Docker lo define compose (volumen /app/categories_data). Local: ruta a data/categories
# (ej. ./python-api/data/categories o ruta absoluta) para compartir con python-api.
# CATEGORIES_DATA_PATH=./python-api/data/categories

# ---------- Desarrollo: bypass de auth (solo local) ----------
# LOCAL_DEV_AUTH_BYPASS=false

# ---------- Python API - Credenciales por proveedor (dejar vacío si no aplica) ----------
SUPPLIER_AIR_URL=
SUPPLIER_AIR_USER=
SUPPLIER_AIR_PASSWORD=
# Elit: URL base del CSV (sin query; el fetcher agrega user_id y token)
# Ej: https://clientes.elit.com.ar/v1/api/productos/csv
SUPPLIER_ELIT_URL=
SUPPLIER_ELIT_USER_ID=
SUPPLIER_ELIT_TOKEN=
# HDC: cargado manualmente (como EIKON). Credenciales solo en el entorno del proceso manual.
SUPPLIER_INVID_URL=
SUPPLIER_INVID_USER=
SUPPLIER_INVID_PASSWORD=
SUPPLIER_NB_URL=
SUPPLIER_NB_API_KEY=
SUPPLIER_NB_TOKEN=
SUPPLIER_MEGA_URL=
SUPPLIER_MEGA_USER=
SUPPLIER_MEGA_PASSWORD=
# Contraseña del Excel de MEGA si el listado viene con protección de edición (opcional)
# MEGA_EXCEL_PASSWORD=
